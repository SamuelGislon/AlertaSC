# Copy to .env and generate local-only values before starting services.
# This file intentionally contains no reusable credentials.
NODE_ENV=development
PORT_API=3001
PORT_WEB=5173
PORT_WORKER=3002
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=
DATABASE_TEST_URL=
DATABASE_SSL=false
# Hosted PostgreSQL CA certificate as one-line base64 PEM, when required by the provider.
DATABASE_SSL_CA_BASE64=
POSTGRES_USER=alertasc
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FIELD_ENCRYPTION_KEY=
LOOKUP_HMAC_KEY=
PERSONAL_DATA_MODE=synthetic
LOG_LEVEL=info
# Optional for local seeding; required on the first production synthetic bootstrap.
# Keep these values only in your secret manager or service environment, never in Git.
SYNTHETIC_ADMIN_LOGIN=
SYNTHETIC_ADMIN_PASSWORD=
